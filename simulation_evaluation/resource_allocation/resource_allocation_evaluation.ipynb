    "   \"source\": [\n",
    "    \"records = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for method, runs in logs.items():\\n\",\n",
    "    \"    if not runs:\\n\",\n",
    "    \"        continue\\n\",\n",
    "    \"    for run_idx, df in enumerate(runs):\\n\",\n",
    "    \"        # Filter to completed cases (proxy: > MIN_EVENTS_PER_CASE events)\\n\",\n",
    "    \"        counts = df.groupby(\\\"case:concept:name\\\").size()\\n\",\n",
    "    \"        completed = counts[counts > MIN_EVENTS_PER_CASE].index\\n\",\n",
    "    \"        df = df[df[\\\"case:concept:name\\\"].isin(completed)].copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if df.empty:\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Derive simulation window from the filtered log\\n\",\n",
    "    \"        ts = df[\\\"time:timestamp\\\"]\\n\",\n",
    "    \"        sim_start = ts.min().date()\\n\",\n",
    "    \"        sim_end = ts.max().date()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Metric 1: cycle time\\n\",\n",
    "    \"        ct = compute_cycle_times(df)\\n\",\n",
    "    \"        mean_ct = ct.mean()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Metric 2 & 3: occupation + fairness\\n\",\n",
    "    \"        working_s = compute_working_seconds(df)\\n\",\n",
    "    \"        available_s = compute_available_seconds(avail_df, sim_start, sim_end)\\n\",\n",
    "    \"        occ_df = compute_occupation(working_s, available_s)\\n\",\n",
    "    \"        mean_occ, mad, wmad = fairness_metrics(occ_df[\\\"occupation\\\"], occ_df[\\\"available_seconds\\\"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        records.append({\\n\",\n",
    "    \"            \\\"method\\\": method,\\n\",\n",
    "    \"            \\\"run\\\": run_idx,\\n\",\n",
    "    \"            \\\"n_cases\\\": df[\\\"case:concept:name\\\"].nunique(),\\n\",\n",
    "    \"            \\\"mean_ct_h\\\": mean_ct,\\n\",\n",
    "    \"            \\\"mean_occ\\\": mean_occ,\\n\",\n",
    "    \"            \\\"fairness_mad\\\": mad,\\n\",\n",
    "    \"            \\\"fairness_wmad\\\": wmad,\\n\",\n",
    "    \"        })\\n\",\n",
    "    \"\\n\",\n",
    "    \"if records:\\n\",\n",
    "    \"    summary_df = pd.DataFrame(records)\\n\",\n",
    "    \"    print(summary_df.to_string(index=False))\\n\",\n",
    "    \"else:\\n\",\n",
