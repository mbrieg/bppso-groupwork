    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"a544af8b\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# 01 – Spawn-Rate Optimization\\n\",\n",
    "    \"\\n\",\n",
    "    \"This notebook documents the denominator correction and its impact on spawn-rate calibration.\\n\",\n",
    "    \"\\n\",\n",
    "    \"Workflow in this notebook:\\n\",\n",
    "    \"1. Build reusable foundations (data loading + helper functions).\\n\",\n",
    "    \"2. Compute wrong vs corrected rates and key bias metrics.\\n\",\n",
    "    \"3. Show one informative heatmap and core numeric checks.\\n\",\n",
    "    \"4. Run a holdout backtest and compare model variants.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 2,\n",
    "   \"id\": \"444673c9\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"import pm4py\\n\",\n",
    "    \"\\n\",\n",
    "    \"sns.set_theme(style=\\\"whitegrid\\\")\\n\",\n",
    "    \"rng = np.random.default_rng(42)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def detect_project_root() -> Path:\\n\",\n",
    "    \"    candidates = [Path.cwd(), *Path.cwd().parents]\\n\",\n",
    "    \"    for p in candidates:\\n\",\n",
    "    \"        if (p / \\\"spawn_rates\\\").exists() and (p / \\\"data\\\").exists():\\n\",\n",
    "    \"            return p\\n\",\n",
    "    \"    return Path.cwd()\\n\",\n",
    "    \"\\n\",\n",
    "    \"PROJECT_ROOT = detect_project_root()\\n\",\n",
    "    \"\\n\",\n",
    "    \"EVENT_LOG_PATH = str(PROJECT_ROOT / \\\"data\\\" / \\\"BPI Challenge 2017.xes.gz\\\")\\n\",\n",
    "    \"TIMESTAMP_COL = \\\"time:timestamp\\\"\\n\",\n",
    "    \"ACTIVITY_COL = \\\"concept:name\\\"\\n\",\n",
    "    \"CASE_COL = \\\"case:concept:name\\\"\\n\",\n",
    "    \"START_ACTIVITY = \\\"A_Create Application\\\"\\n\",\n",
    "    \"HOLIDAY_PATH = None\\n\",\n",
    "    \"START_DATE = None\\n\",\n",
    "    \"END_DATE = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"def resolve_event_log_path(path_str: str) -> Path:\\n\",\n",
    "    \"    path = Path(path_str)\\n\",\n",
    "    \"    if path.exists():\\n\",\n",
    "    \"        return path\\n\",\n",
    "    \"\\n\",\n",
    "    \"    candidates = [\\n\",\n",
    "    \"        PROJECT_ROOT / \\\"sim_output\\\" / \\\"final_simulation_log.csv\\\",\\n\",\n",
    "    \"        PROJECT_ROOT / \\\"data\\\" / \\\"BPI Challenge 2017.xes.gz\\\",\\n\",\n",
    "    \"        PROJECT_ROOT / \\\"data\\\" / \\\"DATA.xml\\\",\\n\",\n",
    "    \"    ]\\n\",\n",
    "    \"    existing = [str(candidate) for candidate in candidates if candidate.exists()]\\n\",\n",
    "    \"    hint = (\\n\",\n",
    "    \"        f\\\"Configured EVENT_LOG_PATH not found: {path_str}. \\\"\\n\",\n",
    "    \"        f\\\"Existing candidates: {existing if existing else 'none'}\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    raise FileNotFoundError(hint)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def load_event_log(path: Path) -> pd.DataFrame:\\n\",\n",
    "    \"    suffixes = \\\"\\\".join(path.suffixes).lower()\\n\",\n",
    "    \"    if suffixes.endswith(\\\".xes\\\") or suffixes.endswith(\\\".xes.gz\\\"):\\n\",\n",
    "    \"        return pm4py.convert_to_dataframe(pm4py.read_xes(str(path)))\\n\",\n",
    "    \"    return pd.read_csv(path)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def extract_arrivals(events: pd.DataFrame) -> pd.DataFrame:\\n\",\n",
    "    \"    missing_for_arrivals = [col for col in [CASE_COL, TIMESTAMP_COL] if col not in events.columns]\\n\",\n",
    "    \"    if missing_for_arrivals:\\n\",\n",
    "    \"        raise ValueError(\\n\",\n",
    "    \"            f\\\"Cannot extract arrivals, missing columns {missing_for_arrivals}. \\\"\\n\",\n",
    "    \"            f\\\"Available columns: {list(events.columns)}\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    work = events.copy()\\n\",\n",
    "    \"    work[TIMESTAMP_COL] = pd.to_datetime(work[TIMESTAMP_COL], errors=\\\"coerce\\\")\\n\",\n",
    "    \"    work = work.dropna(subset=[TIMESTAMP_COL])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if ACTIVITY_COL in work.columns and START_ACTIVITY:\\n\",\n",
    "    \"        starts = work[work[ACTIVITY_COL] == START_ACTIVITY].copy()\\n\",\n",
    "    \"        if len(starts) > 0:\\n\",\n",
    "    \"            work = starts\\n\",\n",
    "    \"\\n\",\n",
    "    \"    arrivals_df = (\\n\",\n",
    "    \"        work.groupby(CASE_COL, as_index=False)[TIMESTAMP_COL]\\n\",\n",
    "    \"        .min()\\n\",\n",
    "    \"        .sort_values(TIMESTAMP_COL)\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    return arrivals_df\\n\",\n",
    "    \"\\n\",\n",
    "    \"def build_wrong_and_correct_tables(arrivals_df: pd.DataFrame, holidays_set: set) -> tuple[dict, dict]:\\n\",\n",
    "    \"    data = arrivals_df.copy()\\n\",\n",
    "    \"    data[\\\"date\\\"] = data[TIMESTAMP_COL].dt.floor(\\\"D\\\")\\n\",\n",
    "    \"    data[\\\"weekday\\\"] = data[TIMESTAMP_COL].dt.weekday\\n\",\n",
    "    \"    data[\\\"hour\\\"] = data[TIMESTAMP_COL].dt.hour\\n\",\n",
    "    \"    data[\\\"is_holiday\\\"] = data[\\\"date\\\"].isin(holidays_set)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    counts = data.groupby([\\\"weekday\\\", \\\"hour\\\", \\\"is_holiday\\\"]).size().rename(\\\"count\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    days_wrong = (\\n\",\n",
    "    \"        data.groupby([\\\"weekday\\\", \\\"hour\\\", \\\"is_holiday\\\"])[\\\"date\\\"]\\n\",\n",
    "    \"        .nunique()\\n\",\n",
    "    \"        .rename(\\\"days_wrong\\\")\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    wrong_table = (counts / days_wrong).to_dict()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    calendar = pd.DataFrame({\\n\",\n",
    "    \"        \\\"date\\\": pd.date_range(data[\\\"date\\\"].min(), data[\\\"date\\\"].max(), freq=\\\"D\\\")\\n\",\n",
    "    \"    })\\n\",\n",
    "    \"    calendar[\\\"weekday\\\"] = calendar[\\\"date\\\"].dt.weekday\\n\",\n",
    "    \"    calendar[\\\"is_holiday\\\"] = calendar[\\\"date\\\"].isin(holidays_set)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    day_exposure = (\\n\",\n",
    "    \"        calendar.groupby([\\\"weekday\\\", \\\"is_holiday\\\"])\\n\",\n",
    "    \"        .size()\\n\",\n",
    "    \"        .rename(\\\"day_exposure\\\")\\n\",\n",
    "    \"        .reset_index()\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    rates = counts.reset_index().merge(day_exposure, on=[\\\"weekday\\\", \\\"is_holiday\\\"], how=\\\"left\\\")\\n\",\n",
    "    \"    rates[\\\"rate_correct\\\"] = rates[\\\"count\\\"] / rates[\\\"day_exposure\\\"]\\n\",\n",
    "    \"    correct_table = {\\n\",\n",
    "    \"        (int(r.weekday), int(r.hour), bool(r.is_holiday)): float(r.rate_correct)\\n\",\n",
    "    \"        for r in rates.itertuples(index=False)\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"    return wrong_table, correct_table\\n\",\n",
    "    \"\\n\",\n",
    "    \"def build_recency_weighted_table(arrivals_df: pd.DataFrame, holidays_set: set, half_life_days: int = 60) -> dict:\\n\",\n",
    "    \"    data = arrivals_df.copy()\\n\",\n",
    "    \"    data[\\\"date\\\"] = data[TIMESTAMP_COL].dt.floor(\\\"D\\\")\\n\",\n",
    "    \"    data[\\\"weekday\\\"] = data[TIMESTAMP_COL].dt.weekday\\n\",\n",
    "    \"    data[\\\"hour\\\"] = data[TIMESTAMP_COL].dt.hour\\n\",\n",
    "    \"    data[\\\"is_holiday\\\"] = data[\\\"date\\\"].isin(holidays_set)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ref_date = data[\\\"date\\\"].max()\\n\",\n",
    "    \"    age_days = (ref_date - data[\\\"date\\\"]).dt.days.astype(float)\\n\",\n",
    "    \"    data[\\\"weight\\\"] = np.power(0.5, age_days / float(half_life_days))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    weighted_counts = (\\n\",\n",
    "    \"        data.groupby([\\\"weekday\\\", \\\"hour\\\", \\\"is_holiday\\\"])[\\\"weight\\\"]\\n\",\n",
    "    \"        .sum()\\n\",\n",
    "    \"        .rename(\\\"weighted_count\\\")\\n\",\n",
    "    \"        .reset_index()\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    unique_days = data[[\\\"date\\\"]].drop_duplicates().copy()\\n\",\n",
    "    \"    unique_days[\\\"weekday\\\"] = unique_days[\\\"date\\\"].dt.weekday\\n\",\n",
    "    \"    unique_days[\\\"is_holiday\\\"] = unique_days[\\\"date\\\"].isin(holidays_set)\\n\",\n",
    "    \"    day_age = (ref_date - unique_days[\\\"date\\\"]).dt.days.astype(float)\\n\",\n",
    "    \"    unique_days[\\\"weight\\\"] = np.power(0.5, day_age / float(half_life_days))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    weighted_exposure = (\\n\",\n",
    "    \"        unique_days.groupby([\\\"weekday\\\", \\\"is_holiday\\\"])[\\\"weight\\\"]\\n\",\n",
    "    \"        .sum()\\n\",\n",
    "    \"        .rename(\\\"weighted_exposure\\\")\\n\",\n",
    "    \"        .reset_index()\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    rates = weighted_counts.merge(weighted_exposure, on=[\\\"weekday\\\", \\\"is_holiday\\\"], how=\\\"left\\\")\\n\",\n",
    "    \"    rates[\\\"rate\\\"] = rates[\\\"weighted_count\\\"] / rates[\\\"weighted_exposure\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        (int(r.weekday), int(r.hour), bool(r.is_holiday)): float(r.rate)\\n\",\n",
    "    \"        for r in rates.itertuples(index=False)\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"def expected_total_from_table(rate_table: dict, dates: pd.DatetimeIndex, holidays_set: set) -> float:\\n\",\n",
    "    \"    total = 0.0\\n\",\n",
    "    \"    for day in dates:\\n\",\n",
    "    \"        wd = int(day.weekday())\\n\",\n",
    "    \"        hol = bool(day.floor(\\\"D\\\") in holidays_set)\\n\",\n",
    "    \"        for hr in range(24):\\n\",\n",
    "    \"            total += rate_table.get((wd, hr, hol), 0.0)\\n\",\n",
    "    \"    return total\\n\",\n",
    "    \"\\n\",\n",
    "    \"def evaluate_on_test(arrivals_test: pd.DataFrame, rate_table: dict, holidays_set: set, label: str) -> dict:\\n\",\n",
    "    \"    test = arrivals_test.copy()\\n\",\n",
    "    \"    test[\\\"date\\\"] = test[TIMESTAMP_COL].dt.floor(\\\"D\\\")\\n\",\n",
    "    \"    test[\\\"weekday\\\"] = test[TIMESTAMP_COL].dt.weekday\\n\",\n",
    "    \"    test[\\\"hour\\\"] = test[TIMESTAMP_COL].dt.hour\\n\",\n",
    "    \"    test[\\\"is_holiday\\\"] = test[\\\"date\\\"].isin(holidays_set)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    test_days = pd.date_range(test[\\\"date\\\"].min(), test[\\\"date\\\"].max(), freq=\\\"D\\\")\\n\",\n",
    "    \"    n_days = len(test_days)\\n\",\n",
    "    \"    observed_total = len(test)\\n\",\n",
    "    \"    expected_total = expected_total_from_table(rate_table, test_days, holidays_set)\\n\",\n",
    "    \"    observed_daily = observed_total / n_days\\n\",\n",
    "    \"    expected_daily = expected_total / n_days\\n\",\n",
    "    \"\\n\",\n",
    "    \"    observed_slot = test.groupby([\\\"weekday\\\", \\\"hour\\\", \\\"is_holiday\\\"]).size().rename(\\\"obs_count\\\").reset_index()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    exposure = pd.DataFrame({\\\"date\\\": test_days})\\n\",\n",
    "    \"    exposure[\\\"weekday\\\"] = exposure[\\\"date\\\"].dt.weekday\\n\",\n",
    "    \"    exposure[\\\"is_holiday\\\"] = exposure[\\\"date\\\"].isin(holidays_set)\\n\",\n",
    "    \"    exposure = exposure.groupby([\\\"weekday\\\", \\\"is_holiday\\\"]).size().rename(\\\"exposure_days\\\").reset_index()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    rows = []\\n\",\n",
    "    \"    for wd in range(7):\\n\",\n",
    "    \"        for hr in range(24):\\n\",\n",
    "    \"            for hol in [False, True]:\\n\",\n",
    "    \"                rows.append({\\n\",\n",
    "    \"                    \\\"weekday\\\": wd,\\n\",\n",
    "    \"                    \\\"hour\\\": hr,\\n\",\n",
    "    \"                    \\\"is_holiday\\\": hol,\\n\",\n",
    "    \"                    \\\"pred_rate\\\": rate_table.get((wd, hr, hol), 0.0),\\n\",\n",
    "    \"                })\\n\",\n",
    "    \"    pred_slot = pd.DataFrame(rows).merge(exposure, on=[\\\"weekday\\\", \\\"is_holiday\\\"], how=\\\"left\\\")\\n\",\n",
    "    \"    pred_slot[\\\"exposure_days\\\"] = pred_slot[\\\"exposure_days\\\"].fillna(0)\\n\",\n",
    "    \"    pred_slot[\\\"pred_count\\\"] = pred_slot[\\\"pred_rate\\\"] * pred_slot[\\\"exposure_days\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    slot_cmp = pred_slot.merge(observed_slot, on=[\\\"weekday\\\", \\\"hour\\\", \\\"is_holiday\\\"], how=\\\"left\\\")\\n\",\n",
    "    \"    slot_cmp[\\\"obs_count\\\"] = slot_cmp[\\\"obs_count\\\"].fillna(0)\\n\",\n",
    "    \"    slot_cmp[\\\"abs_err\\\"] = (slot_cmp[\\\"pred_count\\\"] - slot_cmp[\\\"obs_count\\\"]).abs()\\n\",\n",
    "    \"    wmape = slot_cmp[\\\"abs_err\\\"].sum() / max(slot_cmp[\\\"obs_count\\\"].sum(), 1.0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    non_hol = slot_cmp[slot_cmp[\\\"is_holiday\\\"] == False].copy()\\n\",\n",
    "    \"    non_hol[\\\"obs_rate\\\"] = non_hol[\\\"obs_count\\\"] / non_hol[\\\"exposure_days\\\"].replace(0, np.nan)\\n\",\n",
    "    \"    non_hol[\\\"obs_rate\\\"] = non_hol[\\\"obs_rate\\\"].fillna(0)\\n\",\n",
    "    \"    heatmap_mae = (non_hol[\\\"pred_rate\\\"] - non_hol[\\\"obs_rate\\\"]).abs().mean()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    daily_obs = test.groupby(\\\"date\\\").size().reindex(test_days, fill_value=0)\\n\",\n",
    "    \"    window = 14\\n\",\n",
    "    \"    obs_14, pred_14 = [], []\\n\",\n",
    "    \"    if len(test_days) >= window:\\n\",\n",
    "    \"        for start in range(0, len(test_days) - window + 1):\\n\",\n",
    "    \"            chunk = test_days[start:start + window]\\n\",\n",
    "    \"            obs_14.append(float(daily_obs.loc[chunk].sum()))\\n\",\n",
    "    \"            pred_14.append(float(expected_total_from_table(rate_table, chunk, holidays_set)))\\n\",\n",
    "    \"    obs_14 = np.array(obs_14, dtype=float)\\n\",\n",
    "    \"    pred_14 = np.array(pred_14, dtype=float)\\n\",\n",
    "    \"    mape_14 = (np.abs(pred_14 - obs_14) / np.maximum(obs_14, 1.0)).mean() if len(obs_14) else np.nan\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"\\\\n=== Holdout Backtest: {label} ===\\\")\\n\",\n",
    "    \"    print(f\\\"days_test={n_days}\\\")\\n\",\n",
    "    \"    print(f\\\"daily_real={observed_daily:.2f}  daily_model={expected_daily:.2f}  daily_gap_pct={(expected_daily/observed_daily - 1)*100:.2f}\\\")\\n\",\n",
    "    \"    print(f\\\"slot_wmape={wmape:.3f}\\\")\\n\",\n",
    "    \"    print(f\\\"heatmap_mae_nonholiday={heatmap_mae:.4f}\\\")\\n\",\n",
    "    \"    if len(obs_14):\\n\",\n",
    "    \"        print(f\\\"mape_14day={mape_14:.3f}  windows={len(obs_14)}\\\")\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        print(\\\"mape_14day=nan  windows=0 (need >=14 holdout days)\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        \\\"label\\\": label,\\n\",\n",
    "    \"        \\\"days_test\\\": n_days,\\n\",\n",
    "    \"        \\\"daily_real\\\": observed_daily,\\n\",\n",
    "    \"        \\\"daily_model\\\": expected_daily,\\n\",\n",
    "    \"        \\\"daily_gap_pct\\\": (expected_daily / observed_daily - 1) * 100,\\n\",\n",
    "    \"        \\\"slot_wmape\\\": wmape,\\n\",\n",
    "    \"        \\\"heatmap_mae_nonholiday\\\": heatmap_mae,\\n\",\n",
    "    \"        \\\"mape_14day\\\": mape_14,\\n\",\n",
    "    \"    }\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
