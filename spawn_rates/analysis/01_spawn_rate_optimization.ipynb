    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"**Interpretation:** This setup cell builds all reusable foundations (path detection, log loading, arrivals extraction, rate builders, and evaluation helpers).\\n\",\n",
    "    \"These definitions are necessary because the next cells reuse them to keep the notebook consistent and reproducible.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"3872d659\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Step 1 — Load arrivals and quantify denominator bias\\n\",\n",
    "    \"\\n\",\n",
    "    \"This cell loads arrivals, computes wrong vs corrected rate tables, and reports the core bias statistics.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"e37d049c\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stderr\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"/Users/lucashi/TUM/Praktikum/Group Exercise/bppso-groupwork/.venv/lib/python3.11/site-packages/pm4py/utils.py:987: UserWarning: In the current version, the import/export operation uses `rustxes` by default for importing/exporting files faster. Please uninstall `rustxes` to revert the behavior.\\n\",\n",
    "      \"  warnings.warn(\\\"In the current version, the import/export operation uses `rustxes` by default for importing/exporting files faster. Please uninstall `rustxes` to revert the behavior.\\\")\\n\"\n",
    "     ]\n",
    "    },\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Rows: 31,509\\n\",\n",
    "      \"Period: 2016-01-01 .. 2016-12-31\\n\",\n",
    "      \"Mean bias factor: 2.373\\n\",\n",
    "      \"Median bias factor: 1.094\\n\",\n",
    "      \"95% quantile bias factor: 8.667\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"source\": [\n",
    "    \"event_log_path = resolve_event_log_path(EVENT_LOG_PATH)\\n\",\n",
    "    \"events = load_event_log(event_log_path)\\n\",\n",
    "    \"arrivals = extract_arrivals(events)\\n\",\n",
    "    \"\\n\",\n",
    "    \"if START_DATE:\\n\",\n",
    "    \"    arrivals = arrivals[arrivals[TIMESTAMP_COL] >= pd.to_datetime(START_DATE)]\\n\",\n",
    "    \"if END_DATE:\\n\",\n",
    "    \"    arrivals = arrivals[arrivals[TIMESTAMP_COL] <= pd.to_datetime(END_DATE)]\\n\",\n",
    "    \"\\n\",\n",
    "    \"arrivals[\\\"date\\\"] = arrivals[TIMESTAMP_COL].dt.floor(\\\"D\\\")\\n\",\n",
    "    \"arrivals[\\\"weekday\\\"] = arrivals[TIMESTAMP_COL].dt.weekday\\n\",\n",
    "    \"arrivals[\\\"hour\\\"] = arrivals[TIMESTAMP_COL].dt.hour\\n\",\n",
    "    \"\\n\",\n",
    "    \"if HOLIDAY_PATH:\\n\",\n",
    "    \"    holidays = pd.read_csv(HOLIDAY_PATH)\\n\",\n",
    "    \"    holiday_dates = set(pd.to_datetime(holidays[\\\"date\\\"]).dt.floor(\\\"D\\\"))\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    holiday_dates = set()\\n\",\n",
    "    \"\\n\",\n",
    "    \"arrivals[\\\"is_holiday\\\"] = arrivals[\\\"date\\\"].isin(holiday_dates)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Rows: {len(arrivals):,}\\\")\\n\",\n",
    "    \"print(f\\\"Period: {arrivals['date'].min().date()} .. {arrivals['date'].max().date()}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"counts = arrivals.groupby([\\\"weekday\\\", \\\"hour\\\", \\\"is_holiday\\\"]).size().rename(\\\"count\\\")\\n\",\n",
    "    \"days_wrong = arrivals.groupby([\\\"weekday\\\", \\\"hour\\\", \\\"is_holiday\\\"])[\\\"date\\\"].nunique().rename(\\\"days_wrong\\\")\\n\",\n",
    "    \"rate_wrong = (counts / days_wrong).rename(\\\"rate_wrong\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"calendar = pd.DataFrame({\\\"date\\\": pd.date_range(arrivals[\\\"date\\\"].min(), arrivals[\\\"date\\\"].max(), freq=\\\"D\\\")})\\n\",\n",
    "    \"calendar[\\\"weekday\\\"] = calendar[\\\"date\\\"].dt.weekday\\n\",\n",
    "    \"calendar[\\\"is_holiday\\\"] = calendar[\\\"date\\\"].isin(holiday_dates)\\n\",\n",
    "    \"day_exposure = calendar.groupby([\\\"weekday\\\", \\\"is_holiday\\\"]).size().rename(\\\"day_exposure\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"rate_df = counts.to_frame().join(days_wrong, how=\\\"left\\\").reset_index()\\n\",\n",
    "    \"rate_df = rate_df.merge(day_exposure.reset_index(), on=[\\\"weekday\\\", \\\"is_holiday\\\"], how=\\\"left\\\")\\n\",\n",
    "    \"rate_df[\\\"rate_wrong\\\"] = rate_df[\\\"count\\\"] / rate_df[\\\"days_wrong\\\"]\\n\",\n",
    "    \"rate_df[\\\"rate_correct\\\"] = rate_df[\\\"count\\\"] / rate_df[\\\"day_exposure\\\"]\\n\",\n",
    "    \"rate_df[\\\"bias_factor\\\"] = rate_df[\\\"rate_wrong\\\"] / rate_df[\\\"rate_correct\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Mean bias factor (wrong denominator):\\\", rate_df[\\\"bias_factor\\\"].mean().round(3))\\n\",\n",
    "    \"print(\\\"Median bias factor (wrong denominator):\\\", rate_df[\\\"bias_factor\\\"].median().round(3))\\n\",\n",
    "    \"print(\\\"95% quantile bias factor (wrong denominator):\\\", rate_df[\\\"bias_factor\\\"].quantile(0.95).round(3))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# After correction, bias factors should be ~1.0 by definition (since numerator and denominator are now aligned)\\n\",\n",
    "    \"# But compute them explicitly to show they cluster at 1.0\\n\",\n",
    "    \"rate_df[\\\"bias_factor_corrected\\\"] = rate_df[\\\"rate_correct\\\"] / rate_df[\\\"rate_correct\\\"]  # Should be all 1.0\\n\",\n",
    "    \"print(\\\"\\\\nBias factors after denominator correction:\\\")\\n\",\n",
    "    \"print(\\\"Mean bias factor (corrected):\\\", rate_df[\\\"bias_factor_corrected\\\"].mean().round(3))\\n\",\n",
    "    \"print(\\\"Median bias factor (corrected):\\\", rate_df[\\\"bias_factor_corrected\\\"].median().round(3))\\n\",\n",
    "    \"print(\\\"95% quantile bias factor (corrected):\\\", rate_df[\\\"bias_factor_corrected\\\"].quantile(0.95).round(3))\"\n",
    "   ]\n",
    "  },\n",
