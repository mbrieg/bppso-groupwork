    "    \"if summary_df.empty:\\n\",\n",
    "    \"    print(\\\"summary_df is empty. Run the aggregation cell first.\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    summary_stats = (\\n\",\n",
