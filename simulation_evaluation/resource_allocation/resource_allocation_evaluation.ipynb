    "    \"if \\\"summary_df\\\" not in globals() or summary_df.empty:\\n\",\n",
    "    \"    print(\\\"summary_df is empty. Run the basic aggregation cell first.\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    pareto_df = (\\n\",\n",
    "    \"        summary_df.groupby(\\\"method\\\", as_index=False)\\n\",\n",
    "    \"        .agg(\\n\",\n",
    "    \"            cycle_mean=(\\\"mean_ct_h\\\", \\\"mean\\\"),\\n\",\n",
    "    \"            cycle_std=(\\\"mean_ct_h\\\", \\\"std\\\"),\\n\",\n",
    "    \"            fair_mean=(\\\"fairness_mad\\\", \\\"mean\\\"),\\n\",\n",
    "    \"            fair_std=(\\\"fairness_mad\\\", \\\"std\\\"),\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def is_dominated(row, table):\\n\",\n",
    "    \"        better_or_equal = (table[\\\"cycle_mean\\\"] <= row[\\\"cycle_mean\\\"]) & (table[\\\"fair_mean\\\"] <= row[\\\"fair_mean\\\"])\\n\",\n",
    "    \"        strictly_better = (table[\\\"cycle_mean\\\"] < row[\\\"cycle_mean\\\"]) | (table[\\\"fair_mean\\\"] < row[\\\"fair_mean\\\"])\\n\",\n",
    "    \"        return bool((better_or_equal & strictly_better).any())\\n\",\n",
    "    \"\\n\",\n",
    "    \"    pareto_df[\\\"pareto\\\"] = ~pareto_df.apply(is_dominated, axis=1, table=pareto_df)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    label_map = {\\n\",\n",
    "    \"        \\\"random\\\": \\\"Random\\\",\\n\",\n",
