    "    \"arrivals_bt = arrivals[[CASE_COL, TIMESTAMP_COL]].copy().sort_values(TIMESTAMP_COL)\\n\",\n",
    "    \"arrivals_bt[\\\"date\\\"] = arrivals_bt[TIMESTAMP_COL].dt.floor(\\\"D\\\")\\n\",\n",
    "    \"all_days = pd.Series(arrivals_bt[\\\"date\\\"].sort_values().unique())\\n\",\n",
    "    \"\\n\",\n",
    "    \"split_idx = int(len(all_days) * 0.7)\\n\",\n",
    "    \"if split_idx < 14 or (len(all_days) - split_idx) < 14:\\n\",\n",
    "    \"    raise ValueError(\\\"Not enough days for train/test backtest (need >= 28 distinct days).\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"train_days = set(all_days.iloc[:split_idx])\\n\",\n",
    "    \"test_days = set(all_days.iloc[split_idx:])\\n\",\n",
    "    \"arrivals_train = arrivals_bt[arrivals_bt[\\\"date\\\"].isin(train_days)].copy()\\n\",\n",
    "    \"arrivals_test = arrivals_bt[arrivals_bt[\\\"date\\\"].isin(test_days)].copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"wrong_table_bt, correct_table_bt = build_wrong_and_correct_tables(arrivals_train, holiday_dates)\\n\",\n",
    "    \"recency_30 = build_recency_weighted_table(arrivals_train, holiday_dates, half_life_days=30)\\n\",\n",
    "    \"recency_60 = build_recency_weighted_table(arrivals_train, holiday_dates, half_life_days=60)\\n\",\n",
    "    \"recency_90 = build_recency_weighted_table(arrivals_train, holiday_dates, half_life_days=90)\\n\",\n",
    "    \"\\n\",\n",
    "    \"results = []\\n\",\n",
    "    \"results.append(evaluate_on_test(arrivals_test, wrong_table_bt, holiday_dates, \\\"WRONG denominator\\\"))\\n\",\n",
    "    \"results.append(evaluate_on_test(arrivals_test, correct_table_bt, holiday_dates, \\\"CORRECT denominator\\\"))\\n\",\n",
    "    \"results.append(evaluate_on_test(arrivals_test, recency_30, holiday_dates, \\\"RECENCY half_life=30d\\\"))\\n\",\n",
    "    \"results.append(evaluate_on_test(arrivals_test, recency_60, holiday_dates, \\\"RECENCY half_life=60d\\\"))\\n\",\n",
    "    \"results.append(evaluate_on_test(arrivals_test, recency_90, holiday_dates, \\\"RECENCY half_life=90d\\\"))\\n\",\n",
    "    \"\\n\",\n",
    "    \"summary = pd.DataFrame(results)\\n\",\n",
    "    \"summary[\\\"abs_daily_gap_pct\\\"] = summary[\\\"daily_gap_pct\\\"].abs()\\n\",\n",
    "    \"summary[\\\"rank_score\\\"] = (\\n\",\n",
