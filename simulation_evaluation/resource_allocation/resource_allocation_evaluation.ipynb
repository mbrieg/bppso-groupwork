    "    \"            mean_occ_mean=(\\\"mean_occ\\\", \\\"mean\\\"),\\n\",\n",
    "    \"            mean_occ_std=(\\\"mean_occ\\\", \\\"std\\\"),\\n\",\n",
    "    \"            fairness_mad_mean=(\\\"fairness_mad\\\", \\\"mean\\\"),\\n\",\n",
    "    \"            fairness_mad_std=(\\\"fairness_mad\\\", \\\"std\\\"),\\n\",\n",
    "    \"            fairness_wmad_mean=(\\\"fairness_wmad\\\", \\\"mean\\\"),\\n\",\n",
    "    \"            fairness_wmad_std=(\\\"fairness_wmad\\\", \\\"std\\\"),\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        .sort_index()\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    display(summary_stats.round(4))\"\n",
    "   ]\n",
    "  },\n",
