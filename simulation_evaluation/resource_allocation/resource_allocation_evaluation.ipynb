    "    \"    raise FileNotFoundError(\\\"Could not locate repository root from current working directory.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"REPO_ROOT = find_repo_root(Path.cwd().resolve())\\n\",\n",
    "    \"STUDY_DIR = REPO_ROOT / \\\"simulation_evaluation\\\" / \\\"resource_allocation\\\"\\n\",\n",
    "    \"RESULTS_DIR = STUDY_DIR\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Random seed fixed to: {RANDOM_SEED}\\\")\\n\",\n",
    "    \"print(f\\\"Study directory      : {STUDY_DIR}\\\")\\n\",\n",
    "    \"print(f\\\"Repository root      : {REPO_ROOT}\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"07e93c46\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Input Data and Replication Design\\n\",\n",
    "    \"\\n\",\n",
    "    \"Simulation logs are read from `data/<method>/run_NN.csv`.\\n\",\n",
    "    \"Each file is one replication with the same simulator settings; only the allocation method differs.\\n\",\n",
    "    \"\\n\",\n",
    "    \"| Method label | Allocation strategy |\\n\",\n",
    "    \"|---|---|\\n\",\n",
    "    \"| `random` | Uniform random selection from eligible resources |\\n\",\n",
    "    \"| `round_robin` | Strict round-robin over eligible resources |\\n\",\n",
    "    \"| `shortest_queue` | Resource with the shortest internal queue |\\n\",\n",
    "    \"| `batch_k5` | Batching (`k = 5`) with greedy projected-ready-time assignment |\\n\",\n",
    "    \"| `advanced_local` | Greedy cost-based assignment |\\n\",\n",
    "    \"| `advanced_global` | Global assignment with postponement option |\\n\",\n",
    "    \"\\n\",\n",
    "    \"**Simulation horizon:** fixed at **14 simulated calendar days** for all methods.  \\n\",\n",
    "    \"**Completed-case proxy:** cases with more than 2 recorded events.  \\n\",\n",
    "    \"**Availability file:** `resources/availabilities/availabilities_advanced.csv`.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 5,\n",
    "   \"id\": \"0fbb8568\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"  random           ✓  (/Users/lucashi/TUM/Praktikum/Group Exercise/bppso-groupwork/simulation_evaluation/resource_allocation/data/random)\\n\",\n",
    "      \"  round_robin      ✓  (/Users/lucashi/TUM/Praktikum/Group Exercise/bppso-groupwork/simulation_evaluation/resource_allocation/data/round_robin)\\n\",\n",
    "      \"  shortest_queue   ✓  (/Users/lucashi/TUM/Praktikum/Group Exercise/bppso-groupwork/simulation_evaluation/resource_allocation/data/shortest_queue)\\n\",\n",
    "      \"  batch_k5         ✓  (/Users/lucashi/TUM/Praktikum/Group Exercise/bppso-groupwork/simulation_evaluation/resource_allocation/data/batch_k5)\\n\",\n",
    "      \"  advanced_local   ✓  (/Users/lucashi/TUM/Praktikum/Group Exercise/bppso-groupwork/simulation_evaluation/resource_allocation/data/advanced_local)\\n\",\n",
    "      \"  advanced_global  ✓  (/Users/lucashi/TUM/Praktikum/Group Exercise/bppso-groupwork/simulation_evaluation/resource_allocation/data/advanced_global)\\n\",\n",
    "      \"\\n\",\n",
    "      \"  Availability file  ✓  (/Users/lucashi/TUM/Praktikum/Group Exercise/bppso-groupwork/resources/availabilities/availabilities_advanced.csv)\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"source\": [\n",
    "    \"DATA_ROOT = STUDY_DIR / \\\"data\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"METHODS = {\\n\",\n",
    "    \"    \\\"random\\\":          DATA_ROOT / \\\"random\\\",\\n\",\n",
    "    \"    \\\"round_robin\\\":     DATA_ROOT / \\\"round_robin\\\",\\n\",\n",
    "    \"    \\\"shortest_queue\\\":  DATA_ROOT / \\\"shortest_queue\\\",\\n\",\n",
    "    \"    \\\"batch_k5\\\":        DATA_ROOT / \\\"batch_k5\\\",\\n\",\n",
    "    \"    \\\"advanced_local\\\":  DATA_ROOT / \\\"advanced_local\\\",\\n\",\n",
    "    \"    \\\"advanced_global\\\": DATA_ROOT / \\\"advanced_global\\\",\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"AVAIL_FILE = REPO_ROOT / \\\"resources\\\" / \\\"availabilities\\\" / \\\"availabilities_advanced.csv\\\"\\n\",\n",
    "    \"REQUIRED_COLS = {\\\"case:concept:name\\\", \\\"concept:name\\\", \\\"time:timestamp\\\", \\\"lifecycle:transition\\\", \\\"org:resource\\\"}\\n\",\n",
    "    \"MIN_EVENTS_PER_CASE = 2  # proxy for completed cases\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Sanity check\\n\",\n",
    "    \"for label, path in METHODS.items():\\n\",\n",
    "    \"    status = \\\"✓\\\" if path.exists() else \\\"✗ missing\\\"\\n\",\n",
    "    \"    print(f\\\"  {label:<16} {status}  ({path})\\\")\\n\",\n",
    "    \"print(f\\\"\\\\n  Availability file  {'✓' if AVAIL_FILE.exists() else '✗ missing'}  ({AVAIL_FILE})\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"da76d2da\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Data Loading\\n\",\n",
    "    \"\\n\",\n",
    "    \"Reads all replication CSVs for each method, checks the required columns, and stores them in `logs`.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 6,\n",
    "   \"id\": \"fdd49dcf\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def load_method_runs(method_dir: Path) -> list[pd.DataFrame]:\\n\",\n",
    "    \"    \\\"\\\"\\\"Load and validate all run_*.csv files in a method directory.\\\"\\\"\\\"\\n\",\n",
    "    \"    files = sorted(method_dir.glob(\\\"run_*.csv\\\"))\\n\",\n",
    "    \"    if not files:\\n\",\n",
    "    \"        return []\\n\",\n",
    "    \"    runs = []\\n\",\n",
    "    \"    for f in files:\\n\",\n",
    "    \"        df = pd.read_csv(f, parse_dates=[\\\"time:timestamp\\\"])\\n\",\n",
    "    \"        missing = REQUIRED_COLS - set(df.columns)\\n\",\n",
    "    \"        if missing:\\n\",\n",
    "    \"            raise ValueError(f\\\"{f.name}: missing columns {missing}\\\")\\n\",\n",
    "    \"        runs.append(df)\\n\",\n",
    "    \"    return runs\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"logs: dict[str, list[pd.DataFrame]] = {}\\n\",\n",
    "    \"for method, path in METHODS.items():\\n\",\n",
    "    \"    if not path.exists():\\n\",\n",
    "    \"        logs[method] = []\\n\",\n",
    "    \"        continue\\n\",\n",
    "    \"    runs = load_method_runs(path)\\n\",\n",
    "    \"    logs[method] = runs\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"3c363e87\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Metric Helper Functions\\n\",\n",
    "    \"\\n\",\n",
    "    \"Shared helper functions for the basic metrics.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 7,\n",
    "   \"id\": \"938e672b\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Helpers defined. Availability schedule: 140 resources, 763 shift rows.\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"source\": [\n",
    "    \"import datetime\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Activities with explicit start/complete lifecycle pairs (resource time is measurable)\\n\",\n",
    "    \"W_ACTIVITIES = [\\n\",\n",
    "    \"    \\\"W_Call after offers\\\",\\n\",\n",
    "    \"    \\\"W_Call incomplete files\\\",\\n\",\n",
    "    \"    \\\"W_Complete application\\\",\\n\",\n",
    "    \"    \\\"W_Handle leads\\\",\\n\",\n",
    "    \"    \\\"W_Validate application\\\",\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"DAY_ZERO = datetime.date(2016, 1, 1)  # DayId=0 anchor (matches availability schedule)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def compute_cycle_times(df: pd.DataFrame) -> pd.Series:\\n\",\n",
    "    \"    \\\"\\\"\\\"Per-case cycle time in hours (completed cases only).\\\"\\\"\\\"\\n\",\n",
    "    \"    ct = df.groupby(\\\"case:concept:name\\\")[\\\"time:timestamp\\\"].agg([\\\"min\\\", \\\"max\\\"])\\n\",\n",
    "    \"    return (ct[\\\"max\\\"] - ct[\\\"min\\\"]).dt.total_seconds() / 3600\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def compute_working_seconds(df: pd.DataFrame) -> pd.Series:\\n\",\n",
    "    \"    \\\"\\\"\\\"Total working seconds per resource from start/complete event pairs.\\\"\\\"\\\"\\n\",\n",
    "    \"    w = df[df[\\\"concept:name\\\"].isin(W_ACTIVITIES)].copy()\\n\",\n",
    "    \"    starts = (\\n\",\n",
    "    \"        w[w[\\\"lifecycle:transition\\\"] == \\\"start\\\"]\\n\",\n",
    "    \"        [[\\\"case:concept:name\\\", \\\"concept:name\\\", \\\"org:resource\\\", \\\"time:timestamp\\\"]]\\n\",\n",
    "    \"        .rename(columns={\\\"time:timestamp\\\": \\\"start_time\\\"})\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    completes = (\\n\",\n",
    "    \"        w[w[\\\"lifecycle:transition\\\"] == \\\"complete\\\"]\\n\",\n",
    "    \"        [[\\\"case:concept:name\\\", \\\"concept:name\\\", \\\"org:resource\\\", \\\"time:timestamp\\\"]]\\n\",\n",
    "    \"        .rename(columns={\\\"time:timestamp\\\": \\\"end_time\\\"})\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    merged = pd.merge(starts, completes, on=[\\\"case:concept:name\\\", \\\"concept:name\\\", \\\"org:resource\\\"])\\n\",\n",
    "    \"    merged[\\\"working_seconds\\\"] = (merged[\\\"end_time\\\"] - merged[\\\"start_time\\\"]).dt.total_seconds().clip(lower=0)\\n\",\n",
    "    \"    return merged.groupby(\\\"org:resource\\\")[\\\"working_seconds\\\"].sum()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def compute_available_seconds(avail_df: pd.DataFrame, start_date: datetime.date, end_date: datetime.date) -> pd.Series:\\n\",\n",
    "    \"    \\\"\\\"\\\"Total scheduled seconds per resource over the simulation window.\\\"\\\"\\\"\\n\",\n",
    "    \"    result = {}\\n\",\n",
    "    \"    for resource, grp in avail_df.groupby(\\\"Resource\\\"):\\n\",\n",
    "    \"        total = 0.0\\n\",\n",
    "    \"        day = start_date\\n\",\n",
    "    \"        while day <= end_date:\\n\",\n",
    "    \"            day_id = (day - DAY_ZERO).days % 7\\n\",\n",
    "    \"            row = grp[grp[\\\"DayId\\\"] == day_id]\\n\",\n",
    "    \"            if not row.empty:\\n\",\n",
    "    \"                r = row.iloc[0]\\n\",\n",
    "    \"                shift_s = datetime.datetime.combine(day, r[\\\"StartTime\\\"])\\n\",\n",
    "    \"                shift_e = datetime.datetime.combine(day, r[\\\"EndTime\\\"])\\n\",\n",
    "    \"                total += max(0.0, (shift_e - shift_s).total_seconds() - r[\\\"DurationMin\\\"] * 60)\\n\",\n",
    "    \"            day += datetime.timedelta(days=1)\\n\",\n",
    "    \"        result[resource] = total\\n\",\n",
    "    \"    return pd.Series(result, name=\\\"available_seconds\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def compute_occupation(working_s: pd.Series, available_s: pd.Series) -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"DataFrame with working_seconds, available_seconds, and occupation per resource.\\\"\\\"\\\"\\n\",\n",
    "    \"    df = pd.DataFrame({\\\"working_seconds\\\": working_s, \\\"available_seconds\\\": available_s})\\n\",\n",
    "    \"    df[\\\"working_seconds\\\"] = df[\\\"working_seconds\\\"].fillna(0)\\n\",\n",
    "    \"    df = df[df[\\\"available_seconds\\\"] > 0].copy()\\n\",\n",
    "    \"    df[\\\"occupation\\\"] = (df[\\\"working_seconds\\\"] / df[\\\"available_seconds\\\"]).clip(0, 1)\\n\",\n",
    "    \"    return df\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def fairness_metrics(occ_series: pd.Series, avail_seconds: pd.Series | None = None) -> tuple:\\n\",\n",
    "    \"    \\\"\\\"\\\"(mean_occ, MAD, weighted MAD). Lower MAD = more balanced workload.\\\"\\\"\\\"\\n\",\n",
    "    \"    mean_occ = occ_series.mean()\\n\",\n",
    "    \"    mad = (occ_series - mean_occ).abs().mean()\\n\",\n",
    "    \"    if avail_seconds is not None:\\n\",\n",
    "    \"        w = avail_seconds / avail_seconds.sum()\\n\",\n",
    "    \"        wmad = (w * (occ_series - mean_occ).abs()).sum()\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        wmad = np.nan\\n\",\n",
    "    \"    return mean_occ, mad, wmad\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Load and parse availability schedule once\\n\",\n",
    "    \"avail_df = pd.read_csv(AVAIL_FILE)\\n\",\n",
    "    \"avail_df[\\\"StartTime\\\"]   = pd.to_datetime(avail_df[\\\"StartTime\\\"],   format=\\\"%H:%M:%S\\\").dt.time\\n\",\n",
    "    \"avail_df[\\\"EndTime\\\"]     = pd.to_datetime(avail_df[\\\"EndTime\\\"],     format=\\\"%H:%M:%S\\\").dt.time\\n\",\n",
    "    \"avail_df[\\\"DurationMin\\\"] = avail_df[\\\"DurationMin\\\"].fillna(0).astype(int)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Helpers defined. Availability schedule: {avail_df['Resource'].nunique()} resources, {len(avail_df)} shift rows.\\\")\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
